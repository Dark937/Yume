# Prevent directory listing
Options -Indexes

# Deny access to sensitive files
<FilesMatch "^\.|\.env$|\.config\.env$|\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent direct access to scripts, styles, and api from the browser
# (Allows loading them from the site itself, blocks direct copy-paste URL)
RewriteEngine On
RewriteBase /

# 1. Protect scripts/ and styles/ (Allow only if Referer is your site)
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?localhost [NC]
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?yume-store\.altervista\.org [NC]
RewriteRule ^(scripts|styles)/ - [F,L]

# 2. Protect api/ (Block direct GET requests if Referer is empty)
RewriteCond %{REQUEST_FILENAME} \.php$
RewriteCond %{HTTP_REFERER} ^$
RewriteRule ^api/ - [F,L]

# CLEAN URLS (.html extension removal)
# 1. Redirect /page.html to /page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP/
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# 3. Specific fix for /products conflict
RewriteCond %{REQUEST_URI} ^/products/?$ [NC]
RewriteRule ^products/?$ shop.html [NC,L]

# 4. Handle internal mapping for other pages
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]



